<div class="glass-card">
    <h2>Login to AuthX</h2>
    <p style="text-align:center; color: var(--text-muted); margin-bottom: 2rem;">Welcome back! Enter your credentials to continue.</p>
    
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>

        <% if (typeof errorDetails !== 'undefined' && errorDetails && errorDetails.length > 0) { %>
            <div class="alert alert-help">
                <p class="help-title">Details:</p>
                <ul class="help-list">
                    <% errorDetails.forEach(function(issue) { %>
                        <li><%= issue %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="name@company.com"
                value="<%= (typeof formData !== 'undefined' && formData && formData.email) ? formData.email : '' %>"
                required
            >
            <p id="login-email-hint" class="field-hint">Use your registered account email.</p>
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>
            <p id="capslock-hint" class="field-hint" style="display:none; color: #fbbf24;">Caps Lock appears to be ON.</p>
        </div>
        <button type="submit">Unlock System</button>
    </form>

    <div class="link-group">
        <p>Forgot password? <a href="/forgot-password">Reset it here</a></p>
        <p>Don't have an account? <a href="/register">Create one</a></p>
    </div>
</div>
