<div class="glass-card">
    <h2>Signup</h2>
    <p style="text-align:center; color: var(--text-muted); margin-bottom: 2rem;">Join the AuthX workforce. Get started in minutes.</p>
    
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/register" method="POST">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="name@company.com" required>
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Min 1 characters (No validation!)" required>
        </div>
        <button type="submit">Create Account</button>
    </form>

    <div class="link-group">
        <p>Already have an account? <a href="/login">Sign In</a></p>
    </div>
</div>
