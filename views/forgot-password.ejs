<div class="glass-card">
    <h2>Help Me Log In</h2>
    <p style="text-align:center; color: var(--text-muted); margin-bottom: 2rem;">Forgot your password? Enter your email below to start the recovery process.</p>
    
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/forgot-password" method="POST">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="name@company.com" required>
        </div>
        <button type="submit">Send Reset Link</button>
    </form>

    <div class="link-group">
        <p>Actually, I remember! <a href="/login">Go back to login</a></p>
    </div>
</div>