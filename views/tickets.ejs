<div class="dashboard-container">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; gap: 2rem;">
        <h2>Internal Support Tickets</h2>
        <form action="/tickets" method="GET" style="flex: 1; max-width: 400px; display: flex; gap: 0.5rem;">
            <input type="text" name="q" value="<%= locals.search || '' %>" placeholder="Search by title..." style="padding: 0.5rem 1rem;">
            <button type="submit" style="width: auto; margin: 0; padding: 0.5rem 1rem;">Search</button>
        </form>
        <button style="width:auto; padding:0.5rem 1.5rem; margin:0;" onclick="alert('Creating tickets is disabled for this audit demo.')">+ Create New</button>
    </div>

    <% if (tickets.length === 0) { %>
        <p style="text-align:center; color:var(--text-muted); margin-top:3rem;">No active tickets found in the system.</p>
    <% } else { %>
        <div class="ticket-grid">
            <% tickets.forEach(ticket => { %>
                <div class="ticket-card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                        <span class="badge badge-<%= ticket.severity.toLowerCase() %>"><%= ticket.severity %></span>
                        <span style="color:var(--text-muted); font-size:0.75rem;"><%= new Date(ticket.created_at).toLocaleDateString() %></span>
                    </div>
                    <h3 style="margin-bottom:0.5rem; color:white;"><%= ticket.title %></h3>
                    <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.5; margin-bottom:1.5rem;"><%= ticket.description %></p>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="color:white; font-size:0.8rem; font-weight:600;">Status: <%= ticket.status %></span>
                        <button style="width:auto; padding:0.4rem 1rem; font-size:0.75rem; margin:0; background:rgba(255,255,255,0.05); border:1px solid var(--glass-border);">View Details</button>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>
